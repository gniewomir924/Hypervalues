@@ -0,0 +1,104 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Pick a value</title>
+    <link rel="stylesheet" href="style.css">
+    <link rel="icon" type="image/svg+xml" href="icon.svg">
+    <script src="theme.js"></script>
+    <script src="linebreak.js"></script>
+</head>
+<body>
+    <div class="main-container">
+        <div class="question-container">
+            <h2 id="question"></h2>
+        </div>
+
+        <div id="pick-list" class="values-flex-container"></div>
+
+        <div id="buttons"></div>
+    </div>
+
+    <script src="data.js"></script>
+    <script src="scoring.js"></script>
+    <script>
+        // Custom Results: the same step as quiz.html (one category, one value added), but the value is picked
+        // from a visual list instead of being reached by answering questions.
+        const params = new URLSearchParams(window.location.search);
+        const category = params.get('cat');
+        const answers = HV.loadAnswers();
+
+        function backToList() {
+            window.location.href = `results.html#cat-${category}`;
+        }
+
+        // hasOwnProperty: keys such as "constructor" or "__proto__" must not count as categories
+        if (!category || !Object.prototype.hasOwnProperty.call(resultsMapping, category)) {
+            window.location.replace('results.html');
+        } else {
+            document.getElementById('question').innerText = `Pick a value: ${categoryTitles[category] || category}`;
+
+            const list = document.getElementById('pick-list');
+            Object.keys(resultsMapping[category]).forEach(id => {
+                const name = HV.nameOf(category, id);
+                const added = (answers[category] || []).find(item => item.value === id);
+
+                const tile = document.createElement('a');
+                tile.className = 'result-item';
+                tile.href = '#';
+                tile.title = name;
+                tile.style.textDecoration = 'none';
+                tile.style.color = 'inherit';
+                tile.onclick = event => {
+                    event.preventDefault();
+                    addValue(id);
+                };
+
+                const img = document.createElement('img');
+                img.src = `icons/${category}/${id}.svg`;
+                img.className = 'result-icon';
+                img.alt = '';
+                img.onerror = () => { img.style.display = 'none'; };
+                if (added) {
+                    // already in your list: same ring as on the results screen
+                    img.style.borderRadius = '50%';
+                    img.style.boxShadow = `0 0 0 3px var(--bg-color), 0 0 0 6px ${HV.ringColor(added.agree)}`;
+                }
+
+                const label = document.createElement('p');
+                label.className = 'result-text';
+                setName(label, name);
+
+                tile.append(img, label);
+                if (added) {
+                    const agree = document.createElement('p');
+                    agree.className = 'result-agree';
+                    agree.textContent = HV.signed(added.agree);
+                    tile.appendChild(agree);
+                }
+                list.appendChild(tile);
+            });
+            fitNames();
+
+            const back = document.createElement('button');
+            back.innerText = 'Back';
+            back.onclick = backToList;
+            document.getElementById('buttons').appendChild(back);
+        }
+
+        // same rule as quiz.js: a new value matches you (+1); one picked again after being neutral or opposite matches again
+        function addValue(valueId) {
+            const items = answers[category] || (answers[category] = []);
+            const existing = items.find(item => item.value === valueId);
+            if (!existing) {
+                items.push({ value: valueId, agree: 1 });
+            } else if (!(existing.agree > 0)) {
+                existing.agree = 1;
+            }
+            HV.saveAnswers(answers);
+            backToList();
+        }
+    </script>
+</body>
+</html>
